# ====================================================
# Application
# ====================================================
APP_ENV=development           # development | production
APP_SECRET_KEY=change-me-to-a-random-32-char-string
APP_DEBUG=false
LOG_LEVEL=INFO

# ====================================================
# Database
# ====================================================
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5432/ragdb
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ====================================================
# Redis
# ====================================================
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_EMBEDDING=86400      # 24h in seconds
REDIS_TTL_QUERY=3600           # 1h in seconds
REDIS_TTL_SESSION=3600         # 1h in seconds

# ====================================================
# Vector Store (Qdrant)
# ====================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                # Optional, for Qdrant Cloud
QDRANT_COLLECTION_NAME=document_chunks

# ====================================================
# Search (Elasticsearch)
# ====================================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_NAME=document_chunks
ELASTICSEARCH_USERNAME=        # Optional
ELASTICSEARCH_PASSWORD=        # Optional

# ====================================================
# LLM Providers
# ====================================================
# Anthropic (default)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_LARGE_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_SMALL_MODEL=gpt-4o-mini
OPENAI_LARGE_MODEL=gpt-4o

# Google Gemini
GOOGLE_API_KEY=AIza...
GEMINI_SMALL_MODEL=gemini-1.5-flash
GEMINI_LARGE_MODEL=gemini-1.5-pro

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SMALL_MODEL=llama3.2:3b
OLLAMA_LARGE_MODEL=llama3.1:70b

# Active provider selection
SMALL_LLM_PROVIDER=anthropic   # anthropic | openai | gemini | ollama
LARGE_LLM_PROVIDER=anthropic   # anthropic | openai | gemini | ollama

# ====================================================
# Embeddings
# ====================================================
EMBEDDING_PROVIDER=openai      # openai | bge_m3 | e5_large
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# For local embedding models
EMBEDDING_MODEL_PATH=./models  # Local model path
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_RETRIES=3

# ====================================================
# Reranking
# ====================================================
RERANKER_PROVIDER=bge          # bge | cohere
BGE_RERANKER_MODEL=BAAI/bge-reranker-large
COHERE_API_KEY=                # Required for cohere reranker
COHERE_RERANKER_MODEL=rerank-english-v3.0

# ====================================================
# Document Processing
# ====================================================
DEFAULT_LOADER=docling          # docling | unstructured | llamaparse
LLAMAPARSE_API_KEY=             # Optional, for LlamaParse
MAX_FILE_SIZE_MB=100
# dxf/dwg are the CAD formats (src/ingestion/cad/). This value overrides the
# code default, so adding a loader is not enough on its own -- a deployment
# whose .env pins the old list will reject the new type.
ALLOWED_FILE_TYPES=pdf,docx,txt,md,html,png,jpg,jpeg,tiff,bmp,dxf,dwg

# Chunking
PARENT_CHUNK_SIZE=1024          # tokens
CHILD_CHUNK_SIZE=256            # tokens
CHUNK_OVERLAP=32                # tokens

# ====================================================
# Retrieval
# ====================================================
VECTOR_SEARCH_TOP_K=20
BM25_SEARCH_TOP_K=20
RERANK_TOP_N=10
RRF_K=60                        # RRF constant

# ====================================================
# Auth / Security
# ====================================================
JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_CHAT=30              # requests per minute
RATE_LIMIT_UPLOAD=10            # requests per minute
RATE_LIMIT_DEFAULT=200          # requests per minute

# ====================================================
# Authentication (Firebase)
#
# NEVER commit real values. The service-account JSON is a password to every
# account in the project -- see config/README.md.
# ====================================================
FIREBASE_ENABLED=false
# Path to the service-account JSON. config/ is git-ignored.
FIREBASE_SERVICE_ACCOUNT=config/firebase-service-account.json

# Browser-facing Web API key, used by the Streamlit UI to sign users in.
# Firebase console -> Project settings -> General -> Web API Key.
# NOT a secret: it identifies the project and is visible in any browser that
# talks to Firebase. Your data is protected by backend token verification.
FIREBASE_WEB_API_KEY=

# Alternative to the file, for platforms that only offer env vars. The \n
# escapes in the private key are required -- env vars cannot hold literal
# newlines, and the raw PEM is rejected as malformed.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Fail closed: reject requests without a valid token. Set false only during a
# migration window while clients are being updated.
FIREBASE_REQUIRE_AUTH=true
# Restrict sign-in to these email domains. Empty means ANY Google account can
# sign in, which is rarely the intent for an internal corpus.
FIREBASE_ALLOWED_DOMAINS=
# Role granted to a new user. Deliberately the least privileged: signing in
# proves who someone is, not what they may read.
FIREBASE_DEFAULT_ROLE=viewer

# ====================================================
# AI Gateway (src/llm/gateway.py)
#
# Every LLM call goes through the gateway. Switching provider is a change
# here, not a code change.
# ====================================================
# Ordered fallback chain. On a provider error the gateway tries the next one,
# so a single vendor outage degrades instead of failing.
LLM_FALLBACK_PROVIDERS=openai
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# OpenAI-compatible vendors, all served by one provider class.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SMALL_MODEL=openai/gpt-4o-mini
OPENROUTER_LARGE_MODEL=openai/gpt-4o

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Azure addresses a DEPLOYMENT name, not a model name. Mismatching them is
# the usual cause of a 404 on first setup.
AZURE_OPENAI_SMALL_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_LARGE_DEPLOYMENT=gpt-4o

# ====================================================
# Query Router (src/routing/)
# ====================================================
# Below this confidence the router falls back to full document search.
# Answering from the wrong source is a correctness failure; an unnecessary
# retrieval is only a cost -- so ambiguity resolves to the safe direction.
ROUTER_MIN_CONFIDENCE=0.6
# Skip the classifier entirely; only deterministic rules route. Zero
# classifier cost, lower routing precision.
ROUTER_RULES_ONLY=false

# ====================================================
# Tools (src/tools/)
# ====================================================
WEB_SEARCH_PROVIDER=tavily        # tavily | serper
TAVILY_API_KEY=
SERPER_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# Read-only SQL tool. Empty allow-list means the tool is unusable, which is
# the correct default -- never set this to every table.
SQL_TOOL_ALLOWED_TABLES=
SQL_TOOL_MAX_ROWS=100

# ====================================================
# Feature flags (src/governance/feature_flags.py)
#
# Per-environment defaults. An operator override stored in the database wins
# over these at runtime, so an incident does not need a redeploy.
# ====================================================
FEATURE_ENABLE_QUERY_ROUTER=true
# Off by default: sends user queries to a third party and costs money per call.
FEATURE_ENABLE_WEB_SEARCH=false
# Off by default: turns model output into database queries, the largest
# blast-radius increase available to a prompt injection.
FEATURE_ENABLE_SQL_TOOL=false
FEATURE_ENABLE_CALCULATOR=true
FEATURE_ENABLE_RERANKER=true
FEATURE_ENABLE_GUARDRAILS=true
FEATURE_ENABLE_ONLINE_EVAL=true
FEATURE_ENABLE_SEMANTIC_CACHE=true
# Disable to make provider outages loud instead of silently degrading.
FEATURE_ENABLE_LLM_FALLBACK=true

# Kill switches (also flippable at runtime via PUT /governance/flags/{flag})
FEATURE_ANSWERING_ENABLED=true
FEATURE_RETRIEVAL_ENABLED=true
FEATURE_INGESTION_ENABLED=true

# ====================================================
# Governance (NIST AI RMF: Govern / Map / Measure / Manage)
# See docs/governance/GM3_FRAMEWORK.md. These are the machine-readable form
# of the policy; src/governance/policy.py loads them into one frozen AIPolicy
# that the request path, the evaluation runner and the CI gate all share.
# ====================================================

# --- GOVERN ---
GOVERNANCE_POLICY_VERSION=1.0.0
# "enforce" blocks violations; "monitor" counts and audits them but lets the
# request through. Roll new controls out in monitor mode first -- shipping
# straight to enforce is how a well-meaning control takes down a working
# system. An alert fires if it stays in monitor for over 24h.
GOVERNANCE_ENFORCEMENT_MODE=enforce
# Allow-lists checked at pipeline construction: an unapproved model fails at
# startup rather than serving traffic until someone notices.
GOVERNANCE_ALLOWED_LLM_PROVIDERS=openai,anthropic,google,ollama
GOVERNANCE_ALLOWED_EMBEDDING_MODELS=text-embedding-3-large,text-embedding-3-small,BAAI/bge-m3,intfloat/e5-large-v2
GOVERNANCE_REQUIRE_CITATIONS=true
GOVERNANCE_REFUSE_WHEN_NO_CONTEXT=true

# --- MAP (data classification) ---
# What an unlabelled document is treated as. Deliberately NOT "public":
# a document nobody classified is not a public one.
GOVERNANCE_DEFAULT_SENSITIVITY=internal
# What an unrecognised role may read. Deliberately the lowest level.
GOVERNANCE_DEFAULT_CLEARANCE=public
GOVERNANCE_ROLE_CLEARANCE=viewer:public,analyst:internal,steward:confidential,admin:restricted

# --- MEASURE (quality floors) ---
# Read by the CI gate (scripts/eval_gate.py), the Prometheus alert rules, and
# GET /evaluation/gate -- one definition, so the build cannot pass while
# production is failing on the same criterion.
GOVERNANCE_MIN_FAITHFULNESS=0.75
GOVERNANCE_MIN_ANSWER_RELEVANCY=0.70
GOVERNANCE_MIN_CONTEXT_RELEVANCY=0.60
# Fraction of live answers scored by the judge. Costs 3 small-model calls per
# sampled answer, so raise it only as far as the budget allows.
GOVERNANCE_ONLINE_EVAL_SAMPLE_RATE=0.05
GOVERNANCE_ONLINE_EVAL_ENABLED=true

# --- MANAGE ---
GOVERNANCE_RETENTION_DAYS=365

# PII detection and redaction (src/governance/pii.py)
GOVERNANCE_PII_REDACTION_ENABLED=true
# Context redaction stops PII reaching the LLM provider at all -- once a
# passage is in the prompt it has left the deployment, so answer-only
# redaction would be too late.
GOVERNANCE_PII_REDACT_CONTEXT=true
# Answer redaction catches PII the model reconstructed or carried in from
# conversation history, which context redaction cannot reach.
GOVERNANCE_PII_REDACT_ANSWERS=true
# Detectors to run; empty means all. Over-redaction degrades answers, so a
# corpus full of identifier-like strings may want to drop `passport` and
# `ip_address`: email,credit_card,ssn,phone,iban,api_key
GOVERNANCE_PII_DETECTORS=

# ====================================================
# Observability
# ====================================================
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# The OTLP collector endpoint. Leave this unset and configure_tracing() is
# skipped, which makes every span in the process non-recording -- the whole
# pipeline stays instrumented and exports nothing. docker-compose sets this
# to the collector service automatically.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=prod-rag-api

# Grafana admin password (docker-compose observability stack, :3000)
GRAFANA_ADMIN_PASSWORD=admin

# ====================================================
# Streamlit UI
# ====================================================
API_BASE_URL=http://localhost:8000
STREAMLIT_PAGE_TITLE=Enterprise RAG Platform
