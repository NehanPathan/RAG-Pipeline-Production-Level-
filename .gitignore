# ====================================================
# Environment / Secrets
# ====================================================
.env
.env.*
!.env.example

# Service-account credentials and any other secret material. A committed
# Firebase service account is a full compromise of the project's auth: the
# private key signs tokens for every user, so it must never reach the repo.
# The whole directory is ignored (with a keep-file exception) rather than
# just the known filename, so a differently-named credential dropped in
# beside it is covered too.
config/*
!config/.gitkeep
!config/README.md
*service-account*.json
*serviceaccount*.json
*-credentials.json
*.pem
*.key
!**/node_modules/**/*.key

# ====================================================
# Python
# ====================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ====================================================
# Virtual environments
# ====================================================
venv/
.venv/
env/
ENV/

# ====================================================
# uv / pip
# ====================================================
.uv-cache/

# ====================================================
# IDE / Editor
# ====================================================
.vscode/
.idea/
*.swp

# ====================================================
# Claude Code local tool state
# ====================================================
.claude/

# ====================================================
# Project data
# ====================================================
uploads/*
!uploads/.gitkeep
*.log
logs/

# ====================================================
# OS
# ====================================================
.DS_Store
Thumbs.db

# ====================================================
# Alembic (keep migration scripts, ignore local db files)
# ====================================================
*.sqlite3
*.db

# ====================================================
# Node / frontend
# ====================================================
# A dependency tree, not source. `git add -A` swept 10,889 of these into a
# commit once; the negation rule above (`!**/node_modules/**/*.key`) exempts
# key files from the secrets pattern and was the only mention of the
# directory, so nothing had ever ignored it.
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*
