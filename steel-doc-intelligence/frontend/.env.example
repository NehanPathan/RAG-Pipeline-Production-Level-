# Girder frontend configuration.
#
# Copy to `.env.local` and adjust. Every value is optional — the defaults run
# the app standalone against the bundled sample corpus.

# Run against the in-memory sample corpus (default) or the real FastAPI
# service. Set to "false" to talk to the backend.
VITE_USE_MOCKS=true

# Path the client prefixes onto every request. Matches the FastAPI router
# prefix in src/api/main.py.
VITE_API_BASE=/api/v1

# Where the dev server proxies /api. Only used by `npm run dev`; in production
# the reverse proxy in front of both services does this instead.
VITE_API_TARGET=http://localhost:8000
